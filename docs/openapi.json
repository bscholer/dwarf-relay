{
  "components": {
    "schemas": {
      "CapabilitiesOut": {
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "service": {
            "$ref": "#/components/schemas/ServiceInfo"
          },
          "spec_version": {
            "title": "Spec Version",
            "type": "string"
          }
        },
        "required": [
          "spec_version",
          "service",
          "capabilities"
        ],
        "title": "CapabilitiesOut",
        "type": "object"
      },
      "CaptureIn": {
        "properties": {
          "exposure": {
            "default": "15",
            "description": "Seconds per frame: 15, 30, or 60.",
            "title": "Exposure",
            "type": "string"
          },
          "filter": {
            "default": "duo",
            "description": "vis, astro, or duo.",
            "title": "Filter",
            "type": "string"
          },
          "frames": {
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Frames",
            "type": "integer"
          },
          "gain": {
            "default": 60,
            "title": "Gain",
            "type": "integer"
          }
        },
        "required": [
          "frames"
        ],
        "title": "CaptureIn",
        "type": "object"
      },
      "DarkIn": {
        "properties": {
          "exposure": {
            "default": "15",
            "description": "Seconds per frame: 15, 30, or 60.",
            "title": "Exposure",
            "type": "string"
          },
          "frames": {
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Frames",
            "type": "integer"
          },
          "wide": {
            "default": false,
            "description": "true for the wide camera",
            "title": "Wide",
            "type": "boolean"
          }
        },
        "required": [
          "frames"
        ],
        "title": "DarkIn",
        "type": "object"
      },
      "DarkList": {
        "properties": {
          "darks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Darks",
            "type": "array"
          }
        },
        "required": [
          "darks"
        ],
        "title": "DarkList",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail",
          "code"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "GotoIn": {
        "properties": {
          "dec_degrees": {
            "title": "Dec Degrees",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "ra_hours": {
            "title": "Ra Hours",
            "type": "number"
          }
        },
        "required": [
          "name",
          "ra_hours",
          "dec_degrees"
        ],
        "title": "GotoIn",
        "type": "object"
      },
      "Job": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "frames": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frames"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "session": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "Job",
        "type": "object"
      },
      "Message": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "Message",
        "type": "object"
      },
      "MoveIn": {
        "properties": {
          "angle": {
            "description": "Joystick angle in degrees. 0 turns right.",
            "title": "Angle",
            "type": "number"
          },
          "length": {
            "description": "Joystick deflection, 0 to 1.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Length",
            "type": "number"
          },
          "seconds": {
            "description": "Duration in seconds, 5 at most.",
            "exclusiveMinimum": 0.0,
            "maximum": 5.0,
            "title": "Seconds",
            "type": "number"
          }
        },
        "required": [
          "angle",
          "length",
          "seconds"
        ],
        "title": "MoveIn",
        "type": "object"
      },
      "ServiceInfo": {
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "name": {
